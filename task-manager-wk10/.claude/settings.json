{
	"permissions": {
		"deny": [
			"Read(.env)",
			"Read(.env.*)",
			"Read(**/.env)",
			"Read(**/secrets/**)",
			"Edit(.env)",
			"Edit(.env.*)",
			"Bash(curl:*)",
			"Bash(wget:*)",
			"Bash(nc:*)",
			"Bash(ssh:*)",
			"Bash(scp:*)",
			"Bash(rm -rf:*)",
			"Bash(git rm:*)",
			"Bash(sqlite3:*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
					}
				]
			}
		]
	}
}
