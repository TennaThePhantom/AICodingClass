# Copy to .env (never commit .env) and fill in real values.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Flask session signing key (required)
SECRET_KEY=

# Token required by POST /admin/reset (required)
ADMIN_TOKEN=

# Optional: defaults to sqlite:///tasks.db
DATABASE_URL=

# Mailer service credentials
MAILER_API_KEY=
MAILER_SENDER=
